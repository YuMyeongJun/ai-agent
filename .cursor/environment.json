{
  "name": "AI Virtual Office",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "npm run dev:backend"
    },
    {
      "name": "frontend",
      "command": "npm run dev -- --host"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 5173 },
    { "name": "backend", "port": 8000 }
  ]
}
